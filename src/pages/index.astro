---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/common/Header.astro';
import Footer from '@/components/common/Footer.astro';
import Container from '@/components/ui/Container.astro';
import Button from '@/components/ui/Button.astro';
import { withBase } from '@/lib/url';

const projects = [
  {
    name: 'Hydrogen',
    eyebrow: 'Programming language',
    symbol: '{ H }',
    hue: 'lilac',
    description:
      'A programming language and compiler for creating native software across operating systems.',
    href: '/work/hydrogen/',
  },
  {
    name: 'Australis OS',
    eyebrow: 'Operating system',
    symbol: '✳',
    hue: 'peach',
    description:
      'A from-scratch operating system exploring the foundations of a modern desktop experience.',
    href: '/work/australisos/',
  },
  {
    name: 'Quark IDE',
    eyebrow: 'Development environment',
    symbol: '◈',
    hue: 'sky',
    description:
      'A native development environment for writing, building and managing Hydrogen projects.',
    href: '/work/quark/',
  },
];
---

<BaseLayout
  title="Welcome to Aurora Softwares"
  description="Welcome to Aurora Softwares. Discover Hydrogen, Australis OS and Quark IDE—three connected projects exploring the future of software development."
>
  <Header />
  <main id="main" tabindex="-1">
    <section class="welcome" aria-labelledby="welcome-title">
      <Container size="xl">
        <div class="welcome__grid">
          <div class="welcome__copy">
            <p class="eyebrow">Independent software development</p>
            <h1 id="welcome-title">
              Thoughtful software.<br /><span>Built to move forward.</span>
            </h1>
            <p class="welcome__intro">
              Aurora Softwares develops a connected family of technologies:
              Hydrogen, Quark IDE and Australis OS. Our work combines ambitious
              technical ideas with clear, considered design.
            </p>
            <div class="actions">
              <Button href="#projects" variant="solid" size="lg"
                >Explore our projects <span aria-hidden="true">↗</span></Button
              >
              <Button href={withBase('/about/')} variant="outline" size="lg"
                >About Aurora</Button
              >
            </div>
            <p class="welcome__note">
              Independent development · Open source projects
            </p>
          </div>
          <div class="art" aria-hidden="true">
            <div class="art__glow"></div>
            <div class="art__blob art__blob--lilac"></div>
            <div class="art__blob art__blob--blue"></div>
            <div class="art__blob art__blob--peach"></div>
            <div class="art__ring"></div>
            <div class="art__star art__star--one">✳</div>
            <div class="art__star art__star--two">✦</div>
            <div class="art__card art__card--one">
              <span class="art__dot"></span> Language <strong>Tools</strong> Systems
            </div>
            <div class="art__card art__card--two">
              <span class="art__code">{'{ H }'}</span><span>hello, world!</span>
            </div>
            <div class="art__label">ENGINEERED WITH PURPOSE</div>
          </div>
        </div>
      </Container>
    </section>

    <section class="hello-strip" aria-label="What we make">
      <Container size="xl">
        <span>Programming languages</span>
        <span>Development tools</span>
        <span>Operating systems</span>
      </Container>
    </section>

    <section
      class="projects-section"
      id="projects"
      aria-labelledby="projects-title"
    >
      <Container size="xl">
        <div class="section-intro">
          <div>
            <p class="eyebrow">Our projects</p><h2 id="projects-title">
              Different disciplines. <em>One shared vision.</em>
            </h2>
          </div>
          <p>
            Discover the projects we are developing and how they connect—from
            the language to the development tools and operating system.
          </p>
        </div>
        <div class="project-grid">
          {
            projects.map((project) => (
              <article
                class:list={['project-card', `project-card--${project.hue}`]}
              >
                <div class="project-card__art" aria-hidden="true">
                  <>
                    <div class="project-card__shape" />
                    <div class="project-card__shape project-card__shape--small" />
                  </>
                  <span class="project-card__symbol">{project.symbol}</span>
                </div>
                <div class="project-card__body">
                  <p class="project-card__label">{project.eyebrow}</p>
                  <h3>{project.name}</h3>
                  <p>{project.description}</p>
                  <div class="project-card__links">
                    <a href={withBase(project.href)}>
                      Explore {project.name} <span aria-hidden="true">→</span>
                    </a>
                  </div>
                </div>
              </article>
            ))
          }
        </div>
        <div class="projects-more">
          <a href={withBase('/work/')}
            >Explore all projects <span aria-hidden="true">→</span></a
          >
        </div>
      </Container>
    </section>

    <section class="story-section" aria-labelledby="story-title">
      <Container size="xl">
        <div class="story-panel">
          <div class="story-panel__doodle" aria-hidden="true"></div>
          <div class="story-panel__content">
            <p class="eyebrow">Our approach</p>
            <h2 id="story-title">
              Curiosity meets <em>careful engineering.</em>
            </h2>
            <p>
              Our projects balance ambitious technical goals with a clear focus
              on usability. We work across disciplines with an approach that
              values clarity, reliability and continuous improvement.
            </p>
            <Button href={withBase('/about/')} variant="outline" size="lg"
              >Learn about Aurora <span aria-hidden="true">→</span></Button
            >
          </div>
        </div>
      </Container>
    </section>

    <section class="closing" aria-label="Aurora Softwares on GitHub">
      <Container size="xl"
        ><p>Open development</p><h2>
          Follow what we’re <em>building next.</em>
        </h2><Button
          href="https://github.com/Aurora-softwares"
          external
          variant="solid"
          size="lg">Explore on GitHub <span aria-hidden="true">↗</span></Button
        ></Container
      >
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  main {
    overflow: clip;
  }
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 1.5rem;
    color: var(--color-accent-text);
    font: 700 0.8rem/1.4 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .eyebrow__sparkle {
    font-size: 1.3rem;
  }
  .welcome {
    position: relative;
    padding: clamp(5rem, 9vw, 9rem) 0 clamp(6rem, 10vw, 10rem);
  }
  .welcome__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.88fr);
    gap: clamp(1rem, 4vw, 5rem);
    align-items: center;
  }
  .welcome__copy {
    position: relative;
    z-index: 1;
  }
  .welcome h1 {
    max-width: 12ch;
    margin: 0 0 2rem;
    font-size: clamp(3.3rem, 6.8vw, 6.7rem);
    line-height: 1.03;
    letter-spacing: -0.066em;
  }
  .welcome h1 span {
    background: linear-gradient(110deg, #ab81e8, #7da9f2 54%, #e8a3bf);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
  }
  .welcome__intro {
    max-width: 36rem;
    color: var(--color-text-muted);
    font-size: clamp(1.1rem, 1.6vw, 1.4rem);
    line-height: 1.75;
  }
  .actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 2rem;
  }
  .welcome__note {
    margin: 2rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.85rem;
  }
  .art {
    position: relative;
    min-height: 37rem;
    isolation: isolate;
  }
  .art__glow {
    position: absolute;
    inset: 10% 3%;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      #f4d9fc 0,
      #c9e7fe 42%,
      transparent 70%
    );
    opacity: 0.4;
    filter: blur(40px);
  }
  .art__blob {
    position: absolute;
    border-radius: 50% 50% 38% 62% / 53% 30% 70% 47%;
    filter: drop-shadow(0 1.5rem 2rem #596c9c18);
  }
  .art__blob--lilac {
    inset: 11% 25% 26% 13%;
    background: linear-gradient(150deg, #cdb4f8, #a5aaf4);
    transform: rotate(-18deg);
  }
  .art__blob--blue {
    inset: 27% 6% 12% 40%;
    background: linear-gradient(130deg, #b3e6fa, #b4c5fc);
    transform: rotate(30deg);
  }
  .art__blob--peach {
    width: 37%;
    aspect-ratio: 1;
    left: 8%;
    bottom: 5%;
    background: linear-gradient(140deg, #f7d7c2, #f4b4c6);
    transform: rotate(-22deg);
  }
  .art__ring {
    position: absolute;
    width: 74%;
    aspect-ratio: 1;
    top: 12%;
    left: 16%;
    border: 2px solid #ffffffa8;
    border-radius: 50%;
    transform: rotate(25deg) skew(15deg);
  }
  .art__star {
    position: absolute;
    color: #9470d6;
    font-size: 4rem;
    text-shadow: 0 0 22px #fff9;
  }
  .art__star--one {
    top: 2%;
    right: 8%;
  }
  .art__star--two {
    bottom: 5%;
    right: 16%;
    color: #ef9eaa;
  }
  .art__card {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 0.8rem;
    border: 1px solid #ffffffc4;
    border-radius: 1.2rem;
    background: #ffffffd4;
    backdrop-filter: blur(16px);
    box-shadow: 0 1rem 3rem #555f9624;
    color: #434462;
    font-size: 0.84rem;
    padding: 1rem 1.2rem;
  }
  .art__card--one {
    top: 26%;
    left: 0;
    transform: rotate(-4deg);
  }
  .art__card--one strong {
    color: #8f63d4;
  }
  .art__dot {
    height: 0.7rem;
    width: 0.7rem;
    border-radius: 50%;
    background: #ad87e9;
  }
  .art__card--two {
    right: 0;
    bottom: 27%;
    transform: rotate(4deg);
  }
  .art__code {
    display: grid;
    place-items: center;
    width: 2.8rem;
    aspect-ratio: 1;
    border-radius: 0.8rem;
    background: #d7d0ff;
    font-weight: 800;
  }
  .art__label {
    position: absolute;
    bottom: 2%;
    left: 28%;
    color: var(--color-text-muted);
    font: 700 0.69rem var(--font-mono);
    letter-spacing: 0.15em;
  }
  .hello-strip {
    border-block: 1px solid var(--glass-border);
    background: color-mix(in srgb, var(--color-surface) 55%, transparent);
  }
  .hello-strip :global(.container) {
    display: flex;
    justify-content: space-around;
    align-items: center;
    gap: 1rem;
    padding-block: 1.6rem;
    color: var(--color-text-muted);
    font-size: 0.85rem;
    font-weight: 700;
    text-align: center;
  }
  .hello-strip span:nth-child(even) {
    color: #b38bdc;
    font-size: 1.5rem;
  }
  .projects-section {
    padding: clamp(6rem, 10vw, 10rem) 0;
  }
  .section-intro {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 3rem;
    margin-bottom: 3rem;
  }
  .section-intro h2,
  .story-panel h2,
  .closing h2 {
    max-width: 14ch;
    margin: 0;
    font-size: clamp(2.8rem, 5.4vw, 5.5rem);
    letter-spacing: -0.065em;
    line-height: 1.07;
  }
  .section-intro h2 em,
  .story-panel h2 em,
  .closing h2 em {
    color: var(--color-accent-text);
    font-family: Georgia, serif;
    font-weight: 400;
  }
  .section-intro > p {
    max-width: 24rem;
    color: var(--color-text-muted);
    font-size: 1.1rem;
    line-height: 1.7;
  }
  .project-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .project-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--glass-border);
    border-radius: 1.35rem;
    background: color-mix(in srgb, var(--color-surface) 90%, transparent);
    box-shadow: 0 10px 35px #4c4d8010;
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }
  .project-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 18px 35px #4c4d801a;
  }
  .project-card__art {
    position: relative;
    min-height: 15rem;
    overflow: hidden;
    display: grid;
    place-items: center;
    background: #e8dcfa;
  }
  .project-card--sky .project-card__art {
    background: #d9ebfc;
  }
  .project-card--peach .project-card__art {
    background: #fbe2dc;
  }
  .project-card__shape {
    position: absolute;
    width: 12rem;
    aspect-ratio: 1;
    background: #bba5f4;
    border-radius: 40% 60% 55% 45% / 45% 38% 62% 55%;
    transform: rotate(30deg);
  }
  .project-card--sky .project-card__shape {
    background: #9bc6f1;
  }
  .project-card--peach .project-card__shape {
    background: #efb9c4;
  }
  .project-card__shape--small {
    width: 8rem;
    transform: translate(6rem, -4rem) rotate(20deg);
    opacity: 0.5;
  }
  .project-card__symbol {
    position: relative;
    z-index: 1;
    font-size: clamp(3.5rem, 7vw, 6rem);
    font-weight: 800;
    color: #5c4b83;
    text-shadow: 0 8px 25px #ffffff87;
  }
  .project-card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.8rem;
  }
  .project-card__label {
    margin: 0 0 1rem;
    color: var(--color-accent-text);
    font: 0.74rem var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .project-card h3 {
    margin: 0 0 1rem;
    font-size: 2.3rem;
    letter-spacing: -0.05em;
  }
  .project-card__body > p:not(.project-card__label) {
    color: var(--color-text-muted);
    line-height: 1.7;
    margin: 0 0 1rem;
  }
  .project-card small {
    display: block;
    margin-top: auto;
    padding-top: 1rem;
    font-style: italic;
    color: var(--color-text-muted);
  }
  .project-card__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem 1.3rem;
    margin-top: 1.6rem;
    border-top: 1px solid var(--glass-border);
    padding-top: 1.3rem;
  }
  .project-card__links a,
  .projects-more a {
    color: var(--color-accent-text);
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
  }
  .project-card__links a:hover,
  .projects-more a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .projects-more {
    text-align: center;
    margin-top: 2.5rem;
  }
  .story-section {
    padding: 1rem 0 5rem;
  }
  .story-panel {
    position: relative;
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    align-items: center;
    min-height: 28rem;
    padding: clamp(2rem, 6vw, 6rem);
    border-radius: 2rem;
    border: 1px solid var(--glass-border);
    background: linear-gradient(130deg, #e9dffacb, #d7e8fdab 55%, #f9e5e5c4);
    overflow: hidden;
  }
  [data-theme='dark'] .story-panel {
    background: linear-gradient(130deg, #42345d, #283f58 55%, #5c394c);
  }
  .story-panel__doodle {
    position: relative;
    min-height: 19rem;
  }
  .story-panel__doodle::before,
  .story-panel__doodle::after {
    content: '';
    position: absolute;
    border-radius: 46% 54% 61% 39% / 56% 43% 57% 44%;
  }
  .story-panel__doodle::before {
    inset: 8% 19% 12% 0;
    background: linear-gradient(145deg, #c6b2eccc, #a9c9efaa);
    transform: rotate(-15deg);
  }
  .story-panel__doodle::after {
    width: 46%;
    aspect-ratio: 1;
    top: 5%;
    right: 12%;
    border: 2px solid #ffffffa8;
    transform: rotate(18deg);
  }
  .story-panel__content {
    position: relative;
    z-index: 1;
  }
  .story-panel h2 {
    max-width: 15ch;
  }
  .story-panel__content > p:not(.eyebrow) {
    max-width: 35rem;
    color: var(--color-text-muted);
    line-height: 1.8;
    font-size: 1.05rem;
    margin: 1.5rem 0 2rem;
  }
  .closing {
    padding: 5rem 0 8rem;
    text-align: center;
  }
  .closing p {
    color: var(--color-accent-text);
    font-weight: 700;
  }
  .closing h2 {
    margin: 1.5rem auto 2rem;
    max-width: 15ch;
  }
  @media (max-width: 1024px) {
    .welcome__grid {
      grid-template-columns: 1fr;
    }
    .art {
      max-width: 36rem;
      width: 100%;
      margin: auto;
      min-height: 30rem;
    }
    .section-intro {
      align-items: start;
      flex-direction: column;
      gap: 0.5rem;
    }
    .project-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .project-card:last-child {
      grid-column: 1/-1;
    }
    .project-card:last-child .project-card__art {
      min-height: 12rem;
    }
    .story-panel {
      grid-template-columns: 0.5fr 1fr;
    }
  }
  @media (max-width: 640px) {
    .welcome {
      padding-top: 4.5rem;
    }
    .welcome h1 {
      font-size: clamp(3rem, 12vw, 4.5rem);
    }
    .art {
      min-height: 23rem;
    }
    .art__card {
      font-size: 0.67rem;
      padding: 0.7rem;
    }
    .hello-strip :global(.container) {
      flex-wrap: wrap;
    }
    .hello-strip span:nth-child(even) {
      display: none;
    }
    .project-grid {
      grid-template-columns: 1fr;
    }
    .project-card:last-child {
      grid-column: auto;
    }
    .story-panel {
      grid-template-columns: 1fr;
    }
    .story-panel__doodle {
      min-height: 9rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .project-card {
      transition: none;
    }
    .project-card:hover {
      transform: none;
    }
  }
</style>
