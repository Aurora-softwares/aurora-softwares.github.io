---
import { Picture as AstroPicture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { withBase } from '@/lib/url';

export interface Props {
  src: ImageMetadata | string;
  alt: string;
  width?: number;
  height?: number;
  widths?: number[];
  sizes?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  class?: string;
}

const {
  src,
  alt,
  width,
  height,
  widths,
  sizes,
  loading = 'lazy',
  fetchpriority,
  class: className,
} = Astro.props;

// Imported assets (ImageMetadata) are optimized to AVIF first, then WebP.
// Plain string paths (public/ or remote) are rendered as-is.
const isLocalAsset = typeof src !== 'string';
const isSvg = isLocalAsset && (src as ImageMetadata).format === 'svg';
const staticSrc = isLocalAsset && !isSvg ? (src as ImageMetadata).src : withBase(src as string);
const staticWidth = width ?? (isSvg ? (src as ImageMetadata).width : undefined);
const staticHeight = height ?? (isSvg ? (src as ImageMetadata).height : undefined);

// When a caller declares a responsive `sizes` but no explicit width list, emit
// a sensible srcset. All shipped assets are ≥1448px wide, so these stay within
// the source (Astro errors if a width exceeds the original).
const resolvedWidths = widths ?? (sizes ? [400, 800, 1200] : undefined);
---

{
  isLocalAsset ? (
    <AstroPicture
      src={src as ImageMetadata}
      alt={alt}
      formats={['avif', 'webp']}
      fallbackFormat="webp"
      widths={resolvedWidths}
      sizes={sizes}
      loading={loading}
      fetchpriority={fetchpriority}
      class={className}
    />
  ) : (
    <img
      src={staticSrc}
      alt={alt}
      width={staticWidth}
      height={staticHeight}
      loading={loading}
      decoding="async"
      fetchpriority={fetchpriority}
      class={className}
    />
  )
}
